.{
    .name = .vig_assembler,
    .version = "0.1.0",
    .fingerprint = 0x6ad18b352a1d56a3,
    .minimum_zig_version = "0.17.0-dev.1543+6db520a4c",
    .dependencies = .{
        // This package supplies the opcodes, the container format and the
        // verifier. The VM uses the same package.
        .vig_bytecode = .{ .path = "../vig-bytecode" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        // The example programs are part of the package. The VM assembles each one
        // and runs it in a test, so a dependent needs these files and not only
        // the assembler itself.
        "examples",
    },
}
