# Bubble sort over a ten-element array in the data segment.
#
# Every array access here is a computed address: the inner loop compares
# data[j] against data[j+1] and swaps them, and none of those addresses are
# known at assembly time. This is the case plain `load`/`store` cannot express.
#
# data[0..9]  the array being sorted
# data[200]   n, shrinks by one each pass as the tail becomes sorted
# data[201]   j, inner cursor
# data[202]   swapped flag, clears at the start of every pass
# data[203]   temp, holds data[j] across a swap

start:
    push 42
    store 0
    push 7
    store 1
    push 19
    store 2
    push 3
    store 3
    push 88
    store 4
    push 15
    store 5
    push 61
    store 6
    push 4
    store 7
    push 23
    store 8
    push 50
    store 9

    push 10
    store 200

pass:
    push 0
    store 202       # swapped = 0
    push 0
    store 201       # j = 0

inner:
    # while j < n - 1
    load 201
    load 200
    push 1
    sub
    lt
    jmp_zero pass_end

    # if data[j] > data[j + 1]
    load 201
    load_at
    load 201
    push 1
    add
    load_at
    gt
    jmp_zero no_swap

    # temp = data[j]
    load 201
    load_at
    store 203

    # data[j] = data[j + 1]
    load 201
    push 1
    add
    load_at         # value
    load 201        # address
    store_at

    # data[j + 1] = temp
    load 203        # value
    load 201
    push 1
    add             # address
    store_at

    push 1
    store 202       # swapped = 1

no_swap:
    load 201
    push 1
    add
    store 201       # j++
    jmp inner

pass_end:
    # The largest remaining element has bubbled to the end, so shrink the range.
    load 200
    push 1
    sub
    store 200

    # A pass that swapped nothing means the array is sorted.
    load 202
    jmp_not_zero pass

    push sorted_label
    print_string
    pop

    # Print all ten slots. n has been decremented, so the bound is a literal.
    push 0
    store 201

print_loop:
    load 201
    push 10
    lt
    jmp_zero done

    load 201
    load_at
    print
    pop

    load 201
    push 1
    add
    store 201
    jmp print_loop

done:
    halt

sorted_label:
    asciiz "sorted:"
