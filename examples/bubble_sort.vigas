# Bubble sort over a ten-element array in the data segment.
#
# Every array access here is a computed address: the inner loop compares
# data[j] against data[j+1] and swaps them, and none of those addresses are
# known at assembly time. This is the case plain `load`/`store` cannot express.
#
# data[0..9]  the array being sorted
# data[200]   n, shrinks by one each pass as the tail becomes sorted
# data[201]   j, inner cursor
# data[202]   swapped flag, clears at the start of every pass
# data[203]   temp, holds data[j] across a swap

start:
    push 42
    store globals+0
    push 7
    store globals+4
    push 19
    store globals+8
    push 3
    store globals+12
    push 88
    store globals+16
    push 15
    store globals+20
    push 61
    store globals+24
    push 4
    store globals+28
    push 23
    store globals+32
    push 50
    store globals+36

    push 10
    store globals+800

pass:
    push 0
    store globals+808   # swapped = 0
    push 0
    store globals+804   # j = 0

inner:
    # while j < n - 1
    load globals+804
    load globals+800
    push 1
    sub
    lt
    jmp_zero pass_end

    # if data[j] > data[j + 1]
    load globals+804
    # The index becomes a byte address: memory is addressed by byte now.
    push 4
    mul
    push globals
    add
    load_at
    load globals+804
    push 1
    add
    # The index becomes a byte address: memory is addressed by byte now.
    push 4
    mul
    push globals
    add
    load_at
    gt
    jmp_zero no_swap

    # temp = data[j]
    load globals+804
    # The index becomes a byte address: memory is addressed by byte now.
    push 4
    mul
    push globals
    add
    load_at
    store globals+812

    # data[j] = data[j + 1]
    load globals+804
    push 1
    add
    # The index becomes a byte address: memory is addressed by byte now.
    push 4
    mul
    push globals
    add
    load_at         # value
    load globals+804   # address
    # The index becomes a byte address: memory is addressed by byte now.
    push 4
    mul
    push globals
    add
    store_at

    # data[j + 1] = temp
    load globals+812   # value
    load globals+804
    push 1
    add             # address
    # The index becomes a byte address: memory is addressed by byte now.
    push 4
    mul
    push globals
    add
    store_at

    push 1
    store globals+808   # swapped = 1

no_swap:
    load globals+804
    push 1
    add
    store globals+804   # j++
    jmp inner

pass_end:
    # The largest remaining element has bubbled to the end, so shrink the range.
    load globals+800
    push 1
    sub
    store globals+800

    # A pass that swapped nothing means the array is sorted.
    load globals+808
    jmp_not_zero pass

    push sorted_label
    print_string
    pop

    # Print all ten slots. n has been decremented, so the bound is a literal.
    push 0
    store globals+804

print_loop:
    load globals+804
    push 10
    lt
    jmp_zero done

    load globals+804
    # The index becomes a byte address: memory is addressed by byte now.
    push 4
    mul
    push globals
    add
    load_at
    print
    pop

    load globals+804
    push 1
    add
    store globals+804
    jmp print_loop

done:
    halt

sorted_label:
    asciiz "sorted:"

# The globals of this program. Each former slot N is at globals+4N.
globals:
  reserve 816
