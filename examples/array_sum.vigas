# Fill data[0..9] with i*i, then sum the array.
#
# Both loops address the data segment with `store_at` and `load_at`, so neither
# knows which slot it touches until run time. Plain `load`/`store` cannot express
# this, because their address is baked into the instruction.
#
# data[100] = cursor
# data[101] = running total

start:
    push 0
    store globals+400

fill_loop:
    # value = cursor * cursor
    load globals+400
    dup
    mul

    # address = cursor, then data[cursor] = value
    load globals+400
    # The index becomes a byte address: memory is addressed by byte now.
    push 4
    mul
    push globals
    add
    store_at

    # cursor += 1, leaving a copy to test
    load globals+400
    push 1
    add
    dup
    store globals+400

    # continue while cursor != 10
    push 10
    ne
    jmp_not_zero fill_loop

sum_setup:
    push 0
    store globals+404
    push 0
    store globals+400

sum_loop:
    # total += data[cursor]
    load globals+404
    load globals+400
    # The index becomes a byte address: memory is addressed by byte now.
    push 4
    mul
    push globals
    add
    load_at
    add
    store globals+404

    # cursor += 1, leaving a copy to test
    load globals+400
    push 1
    add
    dup
    store globals+400

    push 10
    ne
    jmp_not_zero sum_loop

    # 0+1+4+9+16+25+36+49+64+81 = 285
    load globals+404
    print
    pop
    halt

# The globals of this program. Each former slot N is at globals+4N.
globals:
  reserve 408
