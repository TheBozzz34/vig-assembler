# VIG byte-addressed memory and call-frame test
#
# Expected important results:
#
# Byte-addressed static memory:
#   load8_u:       255
#   load8_s:       -1
#   load16_u:      32769
#   load16_s:      -32767
#   load32:        12345678
#   individual bytes:
#       120
#       86
#       52
#       18
#
# Call frames:
#   basic frame result:       42
#   local byte assembly:      12345678
#   nested frame result:      51

entry start


# ------------------------------------------------------------
# Program entry
# ------------------------------------------------------------

start:
    push memory_heading
    print_string
    pop

    call test_static_memory

    push frame_heading
    print_string
    pop

    call test_basic_frame
    print
    pop

    call test_local_byte_access
    print_hex
    pop

    push 7
    call test_nested_frames
    print
    pop

    push done_message
    print_string
    pop

    halt


# ------------------------------------------------------------
# Test byte-addressed static guest memory
# ------------------------------------------------------------

test_static_memory:
    enter 0 0

    # --------------------------------------------------------
    # Test store8 and load8_u.
    #
    # Store 0xff into buffer[0].
    # Unsigned loading should produce 255.
    # --------------------------------------------------------

    push test_load8_u
    print_string
    pop

    push 255
    push buffer
    store8

    push buffer
    load8_u
    print
    pop

    # --------------------------------------------------------
    # Test load8_s.
    #
    # The same byte, 0xff, interpreted as signed i8 is -1.
    # --------------------------------------------------------

    push test_load8_s
    print_string
    pop

    push buffer
    load8_s
    print
    pop

    # --------------------------------------------------------
    # Test store16 and load16_u.
    #
    # 0x8001 is 32769 as an unsigned 16-bit integer.
    # It is stored at buffer + 1.
    # --------------------------------------------------------

    push 32769
    push buffer
    push 1
    add
    store16

    push test_load16_u
    print_string
    pop

    push buffer
    push 1
    add
    load16_u
    print
    pop

    # --------------------------------------------------------
    # Test load16_s.
    #
    # 0x8001 sign-extends to -32767.
    # --------------------------------------------------------

    push test_load16_s
    print_string
    pop

    push buffer
    push 1
    add
    load16_s
    print
    pop

    # --------------------------------------------------------
    # Test an unaligned 32-bit store.
    #
    # Store 0x12345678 at buffer + 3. The address is not aligned
    # to four bytes, but VIG permits unaligned access.
    # --------------------------------------------------------

    push 305419896             # 0x12345678
    push buffer
    push 3
    add
    store32

    push test_load32
    print_string
    pop

    push buffer
    push 3
    add
    load32
    print_hex
    pop

    # --------------------------------------------------------
    # Confirm little-endian byte order.
    #
    # 0x12345678 should appear in memory as:
    #
    # address + 3: 0x78 = 120
    # address + 4: 0x56 = 86
    # address + 5: 0x34 = 52
    # address + 6: 0x12 = 18
    # --------------------------------------------------------

    push endian_heading
    print_string
    pop

    push buffer
    push 3
    add
    load8_u
    print
    pop

    push buffer
    push 4
    add
    load8_u
    print
    pop

    push buffer
    push 5
    add
    load8_u
    print
    pop

    push buffer
    push 6
    add
    load8_u
    print
    pop

    ret


# ------------------------------------------------------------
# Basic call-frame test
#
# Creates two local variables:
#
# slot 0: local a
# slot 1: local b
#
# Returns a + b, which should be 42.
# ------------------------------------------------------------

test_basic_frame:
    enter 0 2

    push 20
    store_local 0

    push 22
    store_local 1

    load_local 0
    load_local 1
    add

    ret_val


# ------------------------------------------------------------
# Local frame byte-access test
#
# The function creates one local i32. It then obtains the local's
# guest-memory address with local_addr and writes the value
# 0x12345678 one byte at a time.
#
# Because guest memory is little-endian:
#
# local + 0 = 0x78
# local + 1 = 0x56
# local + 2 = 0x34
# local + 3 = 0x12
#
# Loading the complete local should return 0x12345678.
# ------------------------------------------------------------

test_local_byte_access:
    enter 0 1

    # Byte 0
    push 120                  # 0x78
    local_addr 0
    store8

    # Byte 1
    push 86                   # 0x56
    local_addr 0
    push 1
    add
    store8

    # Byte 2
    push 52                   # 0x34
    local_addr 0
    push 2
    add
    store8

    # Byte 3
    push 18                   # 0x12
    local_addr 0
    push 3
    add
    store8

    # Read the assembled i32 through the local-slot instruction.
    load_local 0
    ret_val


# ------------------------------------------------------------
# Nested call-frame test
#
# Input:
#   slot 0: x
#
# Local:
#   slot 1: saved = x + 10
#
# For x = 7:
#   saved = 17
#   inner_frame(17) = 34
#   return 34 + 17 = 51
#
# This tests that the outer function's local frame survives while
# an inner function creates and destroys its own frame.
# ------------------------------------------------------------

test_nested_frames:
    enter 1 1

    load_local 0
    push 10
    add
    store_local 1

    # Pass the outer local to the nested function.
    load_local 1
    call inner_frame

    # The result from inner_frame is on the operand stack.
    # The outer frame and its local must still be intact.
    load_local 1
    add

    ret_val


# ------------------------------------------------------------
# Nested callee
#
# Input:
#   slot 0: value
#
# Local:
#   slot 1: doubled value
# ------------------------------------------------------------

inner_frame:
    enter 1 1

    load_local 0
    push 2
    mul
    store_local 1

    load_local 1
    ret_val


# ------------------------------------------------------------
# Static data
# ------------------------------------------------------------

memory_heading:
    asciiz "=== BYTE-ADDRESSED STATIC MEMORY ==="

frame_heading:
    asciiz "=== CALL FRAME MEMORY ==="

test_load8_u:
    asciiz "load8_u of 0xff; expected 255:"

test_load8_s:
    asciiz "load8_s of 0xff; expected -1:"

test_load16_u:
    asciiz "load16_u of 0x8001; expected 32769:"

test_load16_s:
    asciiz "load16_s of 0x8001; expected -32767:"

test_load32:
    asciiz "unaligned load32; expected 12345678:"

endian_heading:
    asciiz "individual bytes; expected 120, 86, 52, 18:"

done_message:
    asciiz "=== ALL TESTS FINISHED ==="

buffer:
    reserve 16