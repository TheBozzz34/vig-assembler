# data[0] = current value
# data[1] = loop counter

start:
    # current value = 1
    push 1
    store 0

    # counter = 31
    push 31
    store 1

loop:
    # print current value
    load 0
    print
    pop             # print leaves the value on the stack

    # current *= 2
    load 0
    push 2
    mul
    store 0

    # counter--
    load 1
    push 1
    sub
    dup
    store 1

    # continue while counter != 0
    jmp_not_zero loop

    halt