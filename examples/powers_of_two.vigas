# data[0] = current value
# data[1] = loop counter

start:
    # current value = 1
    push 1
    store globals+0

    # counter = 31
    push 31
    store globals+4

loop:
    # print current value
    load globals+0
    print
    pop             # print leaves the value on the stack

    # current *= 2
    load globals+0
    push 2
    mul
    store globals+0

    # counter--
    load globals+4
    push 1
    sub
    dup
    store globals+4

    # continue while counter != 0
    jmp_not_zero loop

    halt

# The globals of this program. Each former slot N is at globals+4N.
globals:
  reserve 8
