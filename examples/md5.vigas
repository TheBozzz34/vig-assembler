# Streaming MD5 in VIGasm.
#
# Input:  arbitrary bytes from stdin
# Output: the canonical 128-bit MD5 digest as four lowercase eight-digit lines
#
# Data layout:
#   0..15    current 512-bit message block
#   16..19   working state a, b, c, d
#   20..23   accumulated state A, B, C, D
#   24       byte position in the current block
#   25..26   total byte count, low and high u32 words
#   28..32   temporary values
#   64..127  MD5 K constants
#   128..191 rotation counts

entry main

main:
  call init_tables

  # Initial MD5 state.
  push 1732584193
  store globals+80
  push -271733879
  store globals+84
  push -1732584194
  store globals+88
  push 271733878
  store globals+92

read_loop:
  read_byte
  dup
  push -1
  eq
  jmp_not_zero finish_input

  # Pack the byte into the current little-endian block.
  call put_byte

  # Increment the 64-bit byte count. Since the low word is incremented by one,
  # a result of zero is exactly the unsigned carry condition.
  load globals+100
  push 1
  add_wrap
  dup
  store globals+100
  jmp_not_zero length_done
  load globals+104
  push 1
  add_wrap
  store globals+104

length_done:
  load globals+96
  push 64
  eq
  jmp_zero read_loop

  call compress
  call clear_block
  push 0
  store globals+96
  jmp read_loop

finish_input:
  pop

  # Append the mandatory one bit, represented by byte 0x80.
  push 128
  call put_byte

  # The final eight bytes hold the original length. If fewer than eight bytes
  # remain, finish this block and place the length in a new zero block.
  load globals+96
  push 56
  gt
  jmp_zero write_length

  call compress
  call clear_block
  push 0
  store globals+96

write_length:
  # Convert the two-word byte count to a two-word bit count.
  load globals+100
  push 3
  shl
  store globals+56

  load globals+104
  push 3
  shl
  load globals+100
  push 29
  shr_u
  or
  store globals+60

  call compress

  # MD5 serializes each state word least-significant byte first. Byte-swap each
  # word before print_hex so the four output lines concatenate to the canonical
  # digest.
  load globals+80
  call print_digest_word
  load globals+84
  call print_digest_word
  load globals+88
  call print_digest_word
  load globals+92
  call print_digest_word
  halt

# Consume one byte from the stack and append it to the current message block.
put_byte:
  store globals+112

  # The word index of the current byte, then the address of that word. A former
  # slot index is multiplied by four and added to the base, because guest memory is
  # addressed by byte now.
  load globals+96
  push 2
  shr_u
  push 4
  mul
  push globals
  add
  store globals+116

  load globals+116
  load_at
  load globals+112
  load globals+96
  push 3
  and
  push 3
  shl
  shl
  or
  load globals+116
  store_at

  load globals+96
  push 1
  add
  store globals+96
  ret

# Clear the sixteen words of the message block.
clear_block:
  push 0
  store globals+120

clear_loop:
  push 0
  load globals+120
  push 4
  mul
  push globals
  add
  store_at

  load globals+120
  push 1
  add
  dup
  store globals+120
  push 16
  ne
  jmp_not_zero clear_loop
  ret

# Process one 512-bit block.
compress:
  load globals+80
  store globals+64
  load globals+84
  store globals+68
  load globals+88
  store globals+72
  load globals+92
  store globals+76

  push 0
  store globals+120

round_loop:
  load globals+120
  push 16
  lt
  jmp_zero round_2

  # F = (b & c) | (~b & d), g = i
  load globals+68
  load globals+72
  and
  load globals+68
  not
  load globals+76
  and
  or
  store globals+124
  # g, then the address of the word of the block that g names.
  load globals+120
  push 4
  mul
  push globals
  add
  store globals+116
  jmp round_update

round_2:
  load globals+120
  push 32
  lt
  jmp_zero round_3

  # F = (d & b) | (~d & c), g = (5*i + 1) mod 16
  load globals+76
  load globals+68
  and
  load globals+76
  not
  load globals+72
  and
  or
  store globals+124
  # g, then the address of the word of the block that g names.
  load globals+120
  push 5
  mul
  push 1
  add
  push 16
  mod
  push 4
  mul
  push globals
  add
  store globals+116
  jmp round_update

round_3:
  load globals+120
  push 48
  lt
  jmp_zero round_4

  # F = b ^ c ^ d, g = (3*i + 5) mod 16
  load globals+68
  load globals+72
  xor
  load globals+76
  xor
  store globals+124
  # g, then the address of the word of the block that g names.
  load globals+120
  push 3
  mul
  push 5
  add
  push 16
  mod
  push 4
  mul
  push globals
  add
  store globals+116
  jmp round_update

round_4:
  # F = c ^ (b | ~d), g = (7*i) mod 16
  load globals+72
  load globals+68
  load globals+76
  not
  or
  xor
  store globals+124
  # g, the word of the block that this round uses, then the address of that word.
  load globals+120
  push 7
  mul
  push 16
  mod
  push 4
  mul
  push globals
  add
  store globals+116

round_update:
  # new_b = b + rotl(a + F + K[i] + M[g], s[i])
  load globals+64
  load globals+124
  add_wrap

  # K[i]. The table was at slot 64, so it is at globals+256 now.
  load globals+120
  push 4
  mul
  push globals+256
  add
  load_at
  add_wrap

  load globals+116
  load_at
  add_wrap

  # s[i], the rotation count. The table was at slot 128, so it is at globals+512.
  load globals+120
  push 4
  mul
  push globals+512
  add
  load_at
  rotl

  load globals+68
  add_wrap
  store globals+128

  # Rotate the working registers: a=d, d=c, c=b, b=new_b.
  load globals+76
  store globals+64
  load globals+72
  store globals+76
  load globals+68
  store globals+72
  load globals+128
  store globals+68

  load globals+120
  push 1
  add
  dup
  store globals+120
  push 64
  ne
  jmp_not_zero round_loop

  load globals+80
  load globals+64
  add_wrap
  store globals+80
  load globals+84
  load globals+68
  add_wrap
  store globals+84
  load globals+88
  load globals+72
  add_wrap
  store globals+88
  load globals+92
  load globals+76
  add_wrap
  store globals+92
  ret

# Print one state word in MD5 byte order.
print_digest_word:
  store globals+112

  load globals+112
  push 255
  and
  push 24
  shl

  load globals+112
  push 65280
  and
  push 8
  shl
  or

  load globals+112
  push 8
  shr_u
  push 65280
  and
  or

  load globals+112
  push 24
  shr_u
  or

  print_hex
  pop
  ret

# Populate the standard MD5 K and rotation tables.
init_tables:
  push -680876936
  store globals+256
  push -389564586
  store globals+260
  push 606105819
  store globals+264
  push -1044525330
  store globals+268
  push -176418897
  store globals+272
  push 1200080426
  store globals+276
  push -1473231341
  store globals+280
