# Streaming MD5 in VIGasm.
#
# Input:  arbitrary bytes from stdin
# Output: the canonical 128-bit MD5 digest as four lowercase eight-digit lines
#
# Data layout:
#   0..15    current 512-bit message block
#   16..19   working state a, b, c, d
#   20..23   accumulated state A, B, C, D
#   24       byte position in the current block
#   25..26   total byte count, low and high u32 words
#   28..32   temporary values
#   64..127  MD5 K constants
#   128..191 rotation counts

entry main

main:
  call init_tables

  # Initial MD5 state.
  push 1732584193
  store 20
  push -271733879
  store 21
  push -1732584194
  store 22
  push 271733878
  store 23

read_loop:
  read_byte
  dup
  push -1
  eq
  jmp_not_zero finish_input

  # Pack the byte into the current little-endian block.
  call put_byte

  # Increment the 64-bit byte count. Since the low word is incremented by one,
  # a result of zero is exactly the unsigned carry condition.
  load 25
  push 1
  add_wrap
  dup
  store 25
  jmp_not_zero length_done
  load 26
  push 1
  add_wrap
  store 26

length_done:
  load 24
  push 64
  eq
  jmp_zero read_loop

  call compress
  call clear_block
  push 0
  store 24
  jmp read_loop

finish_input:
  pop

  # Append the mandatory one bit, represented by byte 0x80.
  push 128
  call put_byte

  # The final eight bytes hold the original length. If fewer than eight bytes
  # remain, finish this block and place the length in a new zero block.
  load 24
  push 56
  gt
  jmp_zero write_length

  call compress
  call clear_block
  push 0
  store 24

write_length:
  # Convert the two-word byte count to a two-word bit count.
  load 25
  push 3
  shl
  store 14

  load 26
  push 3
  shl
  load 25
  push 29
  shr_u
  or
  store 15

  call compress

  # MD5 serializes each state word least-significant byte first. Byte-swap each
  # word before print_hex so the four output lines concatenate to the canonical
  # digest.
  load 20
  call print_digest_word
  load 21
  call print_digest_word
  load 22
  call print_digest_word
  load 23
  call print_digest_word
  halt

# Consume one byte from the stack and append it to the current message block.
put_byte:
  store 28

  load 24
  push 2
  shr_u
  store 29

  load 29
  load_at
  load 28
  load 24
  push 3
  and
  push 3
  shl
  shl
  or
  load 29
  store_at

  load 24
  push 1
  add
  store 24
  ret

# Clear the sixteen words of the message block.
clear_block:
  push 0
  store 30

clear_loop:
  push 0
  load 30
  store_at

  load 30
  push 1
  add
  dup
  store 30
  push 16
  ne
  jmp_not_zero clear_loop
  ret

# Process one 512-bit block.
compress:
  load 20
  store 16
  load 21
  store 17
  load 22
  store 18
  load 23
  store 19

  push 0
  store 30

round_loop:
  load 30
  push 16
  lt
  jmp_zero round_2

  # F = (b & c) | (~b & d), g = i
  load 17
  load 18
  and
  load 17
  not
  load 19
  and
  or
  store 31
  load 30
  store 29
  jmp round_update

round_2:
  load 30
  push 32
  lt
  jmp_zero round_3

  # F = (d & b) | (~d & c), g = (5*i + 1) mod 16
  load 19
  load 17
  and
  load 19
  not
  load 18
  and
  or
  store 31
  load 30
  push 5
  mul
  push 1
  add
  push 16
  mod
  store 29
  jmp round_update

round_3:
  load 30
  push 48
  lt
  jmp_zero round_4

  # F = b ^ c ^ d, g = (3*i + 5) mod 16
  load 17
  load 18
  xor
  load 19
  xor
  store 31
  load 30
  push 3
  mul
  push 5
  add
  push 16
  mod
  store 29
  jmp round_update

round_4:
  # F = c ^ (b | ~d), g = (7*i) mod 16
  load 18
  load 17
  load 19
  not
  or
  xor
  store 31
  load 30
  push 7
  mul
  push 16
  mod
  store 29

round_update:
  # new_b = b + rotl(a + F + K[i] + M[g], s[i])
  load 16
  load 31
  add_wrap

  load 30
  push 64
  add
  load_at
  add_wrap

  load 29
  load_at
  add_wrap

  load 30
  push 128
  add
  load_at
  rotl

  load 17
  add_wrap
  store 32

  # Rotate the working registers: a=d, d=c, c=b, b=new_b.
  load 19
  store 16
  load 18
  store 19
  load 17
  store 18
  load 32
  store 17

  load 30
  push 1
  add
  dup
  store 30
  push 64
  ne
  jmp_not_zero round_loop

  load 20
  load 16
  add_wrap
  store 20
  load 21
  load 17
  add_wrap
  store 21
  load 22
  load 18
  add_wrap
  store 22
  load 23
  load 19
  add_wrap
  store 23
  ret

# Print one state word in MD5 byte order.
print_digest_word:
  store 28

  load 28
  push 255
  and
  push 24
  shl

  load 28
  push 65280
  and
  push 8
  shl
  or

  load 28
  push 8
  shr_u
  push 65280
  and
  or

  load 28
  push 24
  shr_u
  or

  print_hex
  pop
  ret

# Populate the standard MD5 K and rotation tables.
init_tables:
  push -680876936
  store 64
  push -389564586
  store 65
  push 606105819
  store 66
  push -1044525330
  store 67
  push -176418897
  store 68
